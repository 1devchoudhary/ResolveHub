# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=8000
# LOG_LEVEL=info

# Postgres (Neon). Pooled URL for the running API, direct URL for migrations.
DATABASE_URL_POOLED=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/resolvehub?sslmode=verify-full
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/resolvehub?sslmode=verify-full
# DB_POOL_MAX=10

# Integration tests run here and TRUNCATE tables: use a separate database or Neon branch
DATABASE_URL_TEST=postgres://postgres@localhost:5432/resolvehub_test

# Auth. Generate a secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Frontend origin(s) allowed by CORS (comma-separated) and the public app URL used in emails
CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173

# Email via Resend. Leave RESEND_API_KEY empty to log emails to the console instead.
RESEND_API_KEY=
EMAIL_FROM=ResolveHub <onboarding@resend.dev>

# Protects the scheduled demo-data reset endpoint
CRON_SECRET=
